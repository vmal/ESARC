{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local `wrangler dev` / preview. Real deploys always pass --env.
  "name": "esarc",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "esarc" }],
  "observability": { "enabled": true },
  // TURNSTILE_SITE_KEY is public. Local runs use Cloudflare's always-pass
  // test key; staging and production use the esarc.dev widget.
  "vars": {
    "SITE_ENV": "development",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA"
  },

  // Secrets (set with `wrangler secret put <NAME> --env <env>`, never here):
  // BREVO_API_KEY, TURNSTILE_SECRET_KEY, QUICKBOOKS_CLIENT_ID, QUICKBOOKS_CLIENT_SECRET,
  // QUICKBOOKS_OAUTH_STATE_SECRET, QUICKBOOKS_SETUP_TOKEN, plus any other
  // QUICKBOOKS_* settings read in src/lib (see .env.example if present)
  "env": {
    "staging": {
      "name": "esarc-staging",
      "routes": [{ "pattern": "staging.esarc.dev", "custom_domain": true }],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "esarc-staging" }
      ],
      "vars": {
        "SITE_ENV": "staging",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFhEwQ1Y9Rbte6M_"
      }
    },
    "production": {
      "name": "esarc-production",
      "routes": [
        { "pattern": "esarc.dev", "custom_domain": true },
        { "pattern": "www.esarc.dev", "custom_domain": true }
      ],
      "services": [
        { "binding": "WORKER_SELF_REFERENCE", "service": "esarc-production" }
      ],
      "vars": {
        "SITE_ENV": "production",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAFhEwQ1Y9Rbte6M_"
      }
    }
  }
}
